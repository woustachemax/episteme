generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id  String @id @default(uuid())
  name String
  email String @unique
  password String?
  provider Provider
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  search Search[]
  suggestions ArticleSuggestion[]
  threadPosts ThreadPost[]
  postVotes PostVote[]
}

enum Provider{
  GOOGLE
  CREDENTIALS
}

model Search{
  id String @id @default(uuid())
  User User? @relation(fields: [userId], references: [id])
  userId String?
  ipAddress String
  query String
  createdAt DateTime @default(now())
}

model Article {
  id String @id @default(uuid())
  query String @unique
  content String @db.Text
  analysis Json
  factCheck Json
  research Json?
  formatted Json?
  sourcesCount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  suggestions ArticleSuggestion[]
  divergenceThreads DivergenceThread[]
}

model ArticleSuggestion {
  id String @id @default(uuid())
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  author User? @relation(fields: [userId], references: [id])
  userId String?
  oldText String @db.Text
  newText String @db.Text
  reason String
  status SuggestionStatus @default(PENDING)
  votes Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model DivergenceThread {
  id              String   @id @default(uuid())
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId       String
  divergenceIndex Int
  claim           String   @db.Text
  wikipediaSays   String   @db.Text
  independentSays String   @db.Text
  citationIndexes Int[]
  posts           ThreadPost[]
  createdAt       DateTime @default(now())

  @@unique([articleId, divergenceIndex])
}

model ThreadPost {
  id           String   @id @default(uuid())
  thread       DivergenceThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId     String
  parent       ThreadPost? @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId     String?
  replies      ThreadPost[] @relation("Replies")
  authorType   PostAuthorType
  authorUser   User?    @relation(fields: [authorUserId], references: [id])
  authorUserId String?
  agentName    String?
  agentStance  String?
  content      String   @db.Text
  votes        Int      @default(0)
  createdAt    DateTime @default(now())
  votesCast    PostVote[]

  @@index([threadId])
  @@index([parentId])
}

enum PostAuthorType {
  AGENT
  HUMAN
}

model PostVote {
  id     String @id @default(uuid())
  post   ThreadPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User   @relation(fields: [userId], references: [id])
  userId String
  value  Int

  @@unique([postId, userId])
}